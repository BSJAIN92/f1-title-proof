{
  "name": "f1-championship-scenario-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "convex:dev": "convex dev",
    "convex:seed": "tsx --env-file=.env.local scripts/seed-approved-dataset.ts",
    "build:vercel": "convex deploy --cmd 'npm run build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "build": "next build",
    "start": "next start",
    "start:convex:test": "node --env-file=.env.local scripts/start-convex-backed-next.mjs",
    "lint": "eslint .",
    "benchmark:m11": "tsx benchmarks/m11-runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:convex:security": "tsx --env-file=.env.local scripts/verify-convex-credential-gate.ts",
    "verify:deployment": "node scripts/verify-deployment-readiness.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "convex": "1.45.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
