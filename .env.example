# Set by `npx convex dev` for local development and by the Vercel build command for deployments.
NEXT_PUBLIC_CONVEX_URL=

# Local Convex deployment name. Do not commit its real value.
CONVEX_DEPLOYMENT=

# Add this only in Vercel/CI. Never expose it to browser code.
CONVEX_DEPLOY_KEY=

# Same random 32+ character value in this server environment and the matching Convex deployment.
# This name is intentionally not NEXT_PUBLIC_: it must never reach browser code.
CONVEX_SERVER_CREDENTIAL=

# Separate random 32+ character value used only by the approved dataset seed command and Convex deployment.
CONVEX_SEED_CREDENTIAL=
